{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.raisingamsterdam.com" }],
      "destination": "https://raisingamsterdam.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/listings/:id", "destination": "/app-shell.html" },
    { "source": "/reference/:id", "destination": "/app-shell.html" },
    { "source": "/post-listing/:id", "destination": "/app-shell.html" }
  ]
}
